.ghost-inspection-entity-header__icon
{
    background-image: var(--prefab-entity-icon);
    margin-right: 7px;
    width: 16px;
    height: 16px;
    align-content: flex-start;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}
.ghost-inspection-entity-content
{
    margin-left: 0px;
    padding: 5px 10px 5px 10px;

    border-color: #818181;
    border-width: 1.5px;
    border-radius: 7px;

    flex-grow: 1;

    align-content: flex-start;
    justify-content: center;
}

