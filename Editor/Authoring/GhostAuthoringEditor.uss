.ghost-inspection-replication-header__icon
{
    background-image: var(--prefab-entity-icon);
    margin-right: 15px;
    width: 16px;
    height: 16px;
    align-content: flex-start;
    flex-grow: 1;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

